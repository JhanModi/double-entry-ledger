# Copy this file to .env and replace every value. Never commit .env.
# Values here are placeholders only. Used from M1 onward.

# Postgres database and the owner role that runs Flyway migrations.
POSTGRES_DB=ledger
POSTGRES_USER=ledger_owner
POSTGRES_PASSWORD=replace-me

# Restricted role the application connects as (no UPDATE/DELETE on append-only tables).
APP_DB_USER=ledger_app
APP_DB_PASSWORD=replace-me
