# Copy this file to .env and replace every value. Never commit .env.
# Values here are placeholders only. Docker Compose and the app (via spring.config.import) both read .env.

# Postgres database and the owner role. The owner runs Flyway migrations and nothing else (ADR-0015).
POSTGRES_DB=ledger
POSTGRES_USER=ledger_owner
POSTGRES_PASSWORD=replace-me

# The restricted login the application connects as. On first database start, Compose's init script creates it as a
# member of the ledger_app group role, which holds the privileges the migrations grant.
APP_DB_USER=ledger_service
APP_DB_PASSWORD=replace-me

# Optional: where the app finds Postgres. Defaults: localhost and 5432.
# DB_HOST=localhost
# DB_PORT=5432
